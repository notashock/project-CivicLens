# ==============================================================================
# CivicTrace Environment Configuration (.env)
# ==============================================================================

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# If using local PostgreSQL server:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civictrace

# FastAPI Core Backend Settings
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=*

# Next.js Frontend Configuration
# NEXT_PUBLIC_API_URL: Publicly accessible URL for the browser (or empty string for rewrites proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000
# INTERNAL_API_URL: Server-side Next.js rewrite target to FastAPI backend
INTERNAL_API_URL=http://127.0.0.1:8000
WEB_PORT=3000
