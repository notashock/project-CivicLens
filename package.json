{
  "name": "civictrace-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CivicTrace: Anonymous, community-verified civic accountability platform",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web-only",
    "dev:api": "node scripts/dev.mjs --api-only",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "python -m pytest apps/api",
    "test:orchestrator": "node --test scripts/tests/orchestrator.test.mjs",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
